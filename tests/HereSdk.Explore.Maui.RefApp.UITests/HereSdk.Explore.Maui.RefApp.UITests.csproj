<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>NU1900;MA002</NoWarn>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="NSubstitute" Version="5.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>
  <!--
    Shared source from the MAUI library and RefApp (ViewModels, Models, Services).
    Uses Compile with Link to include as source without project reference.
    Platform-specific files (*.Android.cs, *.iOS.cs) are excluded.
  -->
  <ItemGroup>
    <!-- Core -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui\HereSdk.cs" Link="Shared\HereSdk.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\SdkInfo.cs" Link="Shared\SdkInfo.cs" />
    <!-- Models -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Models\**\*.cs" LinkBase="Shared\Models" />
    <!-- Services interfaces and stubs -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\IHereSdkService.cs" Link="Shared\Services\IHereSdkService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\IMapService.cs" Link="Shared\Services\IMapService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\IRoutingService.cs" Link="Shared\Services\IRoutingService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\ISearchService.cs" Link="Shared\Services\ISearchService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\ITrafficService.cs" Link="Shared\Services\ITrafficService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\ILocationService.cs" Link="Shared\Services\ILocationService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\MapService.cs" Link="Shared\Services\MapService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\RoutingService.cs" Link="Shared\Services\RoutingService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\SearchService.cs" Link="Shared\Services\SearchService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\LocationService.cs" Link="Shared\Services\LocationService.cs" />
    <!-- Controls interfaces -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Controls\IHereMapView.cs" Link="Shared\Controls\IHereMapView.cs" />
    <!-- Helpers -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Helpers\**\*.cs" LinkBase="Shared\Helpers" />
    <!-- RefApp Services -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Services\ThemeService.cs" Link="RefApp\Services\ThemeService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Services\ConnectivityService.cs" Link="RefApp\Services\ConnectivityService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Services\PermissionsService.cs" Link="RefApp\Services\PermissionsService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Services\CategoryVisuals.cs" Link="RefApp\Services\CategoryVisuals.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Services\DrawingPalette.cs" Link="RefApp\Services\DrawingPalette.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Services\PanelNavigationService.cs" Link="RefApp\Services\PanelNavigationService.cs" />
    <!-- RefApp ViewModels -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\ViewModels\**\*.cs" LinkBase="RefApp\ViewModels" />
    <!-- RefApp Controls -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Controls\**\*.cs" LinkBase="RefApp\Controls" />
    <MauiXaml Include="..\..\src\HereSdk.Explore.Maui.RefApp\Controls\**\*.xaml" LinkBase="RefApp\Controls" />
    <!-- RefApp Converters -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Converters\**\*.cs" LinkBase="RefApp\Converters" />
    <!-- RefApp Extensions (helpers used by controls/converters above) -->
    <Compile Include="..\..\src\HereSdk.Explore.Maui.RefApp\Extensions\**\*.cs" LinkBase="RefApp\Extensions" />
  </ItemGroup>
</Project>
