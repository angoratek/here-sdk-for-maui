<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The test runner drives the *RefApp* APK already installed on the
      emulator via Appium + UIAutomator2. It does not need to be a MAUI
      app itself — it just hosts an NUnit + Appium client. Targeting
      net10.0-android here would force the testhost to resolve
      `Microsoft.Android` (with the literal version `**FromWorkload**`),
      which fails on the desktop testhost. Targeting plain net10.0 lets
      dotnet test launch the regular desktop testhost.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Here.Explore.Maui.UITests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="5.0.0-rc.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.0.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <!--
    The RefApp project is not referenced via <ProjectReference> because
    that would re-introduce the RefApp's MauiIcon / MauiSplashScreen /
    appsettings assets and trigger a Resizetizer duplicate-name error
    when two MAUI projects are linked from the same source root.

    The tests drive the running APK via Appium's UIAutomator2 driver, so
    the test project does not need to compile the RefApp's source.
  -->

</Project>
