<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>NU1900</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="NSubstitute" Version="5.*" />
  </ItemGroup>
  <!--
    Shared source from the MAUI library (models + interfaces + service stubs).
    Platform-specific files (*.Android.cs, *.iOS.cs) are excluded.
    Uses Compile with Link to include as source without project reference.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\HereSdk.Explore.Maui\HereSdk.cs" Link="Shared\HereSdk.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Models\**\*.cs" LinkBase="Shared\Models" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\IHereSdkService.cs" Link="Shared\Services\IHereSdkService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\IMapService.cs" Link="Shared\Services\IMapService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\IRoutingService.cs" Link="Shared\Services\IRoutingService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\ISearchService.cs" Link="Shared\Services\ISearchService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\ITrafficService.cs" Link="Shared\Services\ITrafficService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\MapService.cs" Link="Shared\Services\MapService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\TrafficService.cs" Link="Shared\Services\TrafficService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\RoutingService.cs" Link="Shared\Services\RoutingService.cs" />
    <Compile Include="..\..\src\HereSdk.Explore.Maui\Services\SearchService.cs" Link="Shared\Services\SearchService.cs" />
  </ItemGroup>
</Project>