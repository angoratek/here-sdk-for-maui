<?xml version="1.0" encoding="UTF-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:searchmodels="clr-namespace:Here.Explore.Maui.Models.Search;assembly=HereSdk.Explore.Maui"
        x:Class="Here.Explore.Maui.RefApp.Controls.SearchResultsList"
        StrokeShape="RoundRectangle 16"
        Background="White"
        Margin="16,4,16,8"
        HorizontalOptions="Fill"
        VerticalOptions="Start"
        MaximumHeightRequest="350"
        IsVisible="{Binding HasResults}">
    <Border.Shadow>
        <Shadow Brush="#50000000" Offset="0,4" Radius="16" />
    </Border.Shadow>
    <CollectionView x:Name="ResultsCollectionView"
                    ItemsSource="{Binding Suggestions}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    BackgroundColor="#FAFAFA">
        <CollectionView.Header>
            <Grid Padding="16,12" BackgroundColor="White">
                <Label Text="Search Results"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#888888" />
                <BoxView HeightRequest="1"
                         BackgroundColor="#EEEEEE"
                         VerticalOptions="End"
                         HorizontalOptions="Fill" />
            </Grid>
        </CollectionView.Header>
        <CollectionView.Footer>
            <BoxView HeightRequest="0" />
        </CollectionView.Footer>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="searchmodels:Suggestion">
                <Grid Padding="16,14" ColumnDefinitions="40,*,20" BackgroundColor="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>

                    <!-- Location icon with background -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#E3F2FD"
                            WidthRequest="36"
                            HeightRequest="36"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                        <Label Text="📍"
                               FontSize="18"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>

                    <!-- Title and type -->
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Margin="12,0,0,0">
                        <Label Text="{Binding Title}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                        <Label Text="{Binding Type}"
                               FontSize="11"
                               TextColor="#888888"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               Margin="0,2,0,0" />
                    </VerticalStackLayout>

                    <!-- Chevron -->
                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="24"
                           TextColor="#888888"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           Opacity="0.6" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</Border>
