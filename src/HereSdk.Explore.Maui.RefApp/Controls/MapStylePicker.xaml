<?xml version="1.0" encoding="UTF-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
        xmlns:ext="clr-namespace:Here.Explore.Maui.RefApp.Extensions"
        x:Class="Here.Explore.Maui.RefApp.Controls.MapStylePicker"
        x:Name="This"
        VerticalOptions="End"
        HorizontalOptions="End"
        StrokeShape="RoundRectangle 16"
        Background="Transparent"
        InputTransparent="false">

    <Grid RowDefinitions="Auto,Auto" MinimumWidthRequest="48" InputTransparent="false">
        <!-- Dropdown panel -->
        <Border Grid.Row="0"
                x:Name="DropdownPanel"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{ext:Themed Surface}"
                IsVisible="{Binding IsDropdownExpanded, Source={x:Reference This}}"
                Margin="0,0,0,8"
                Padding="8"
                InputTransparent="false">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}" Offset="0,4" Radius="16" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="4" InputTransparent="false">
                <Label Text="MAP STYLE"
                       FontSize="11" FontFamily="InterSemiBold"
                       TextColor="{ext:Themed IconMuted}"
                       HorizontalOptions="Center"
                       Margin="0,4,0,4" />

                <VerticalStackLayout Spacing="2"
                                     BindableLayout.ItemsSource="{Binding MapSchemes, Source={x:Reference This}}"
                                     InputTransparent="false">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:MapSchemeItem">
                            <Grid Padding="8,8" InputTransparent="false">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSchemeCommand, Source={x:Reference This}}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontFamily="MaterialIcons"
                                           FontSize="16"
                                           TextColor="{ext:Themed TextSecondary}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Label}"
                                           FontSize="13"
                                           TextColor="{ext:Themed TextPrimary}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Toggle button -->
        <Button Grid.Row="1"
                x:Name="ToggleButton"
                Text="&#xe55b;"
                FontFamily="MaterialIcons"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Command="{Binding ToggleDropdownCommand}"
                FontSize="20"
                TextColor="{ext:Themed TextPrimary}"
                Padding="0"
                BackgroundColor="{ext:Themed Surface}">
            <Button.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}" Offset="0,4" Radius="12" />
            </Button.Shadow>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.7" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>
    </Grid>
</Border>