<?xml version="1.0" encoding="UTF-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
        x:Class="Here.Explore.Maui.RefApp.Controls.DualSearchPanel"
        x:Name="This"
        StrokeShape="RoundRectangle 16"
        Background="White"
        Padding="12,12,12,8"
        Margin="16,16,16,8"
        HorizontalOptions="Fill"
        VerticalOptions="Start">
    <Border.Shadow>
        <Shadow Brush="#40000000" Offset="0,4" Radius="16" />
    </Border.Shadow>

    <Grid RowDefinitions="Auto,Auto,Auto"
          ColumnDefinitions="*,Auto">
        <!-- Origin -->
        <local:SearchLocationInput Grid.Row="0" Grid.Column="0"
                                 Icon="🟦"
                                 Placeholder="Origin"
                                 Query="{Binding OriginQuery, Source={x:Reference This}, Mode=TwoWay}"
                                 Suggestions="{Binding OriginSuggestions, Source={x:Reference This}}"
                                 SearchCommand="{Binding SearchOriginCommand, Source={x:Reference This}}"
                                 SelectSuggestionCommand="{Binding SelectOriginCommand, Source={x:Reference This}}"
                                 ClearCommand="{Binding ClearOriginCommand, Source={x:Reference This}}" />

        <!-- Swap button -->
        <Button Grid.Row="1" Grid.Column="1"
                x:Name="SwapButton"
                Text="⇅"
                WidthRequest="40"
                HeightRequest="40"
                BackgroundColor="#F5F5F5"
                TextColor="#333333"
                BorderColor="#E0E0E0"
                BorderWidth="1"
                CornerRadius="20"
                VerticalOptions="Center"
                HorizontalOptions="End"
                Margin="4,0,0,0"
                Command="{Binding SwapLocationsCommand, Source={x:Reference This}}"
                FontSize="18"
                Padding="0">
            <Button.Shadow>
                <Shadow Brush="#30000000" Offset="0,2" Radius="6" />
            </Button.Shadow>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.7" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>

        <!-- Destination -->
        <local:SearchLocationInput Grid.Row="2" Grid.Column="0"
                                 Icon="🟩"
                                 Placeholder="Destination"
                                 Query="{Binding DestinationQuery, Source={x:Reference This}, Mode=TwoWay}"
                                 Suggestions="{Binding DestinationSuggestions, Source={x:Reference This}}"
                                 SearchCommand="{Binding SearchDestinationCommand, Source={x:Reference This}}"
                                 SelectSuggestionCommand="{Binding SelectDestinationCommand, Source={x:Reference This}}"
                                 ClearCommand="{Binding ClearDestinationCommand, Source={x:Reference This}}" />
    </Grid>
</Border>