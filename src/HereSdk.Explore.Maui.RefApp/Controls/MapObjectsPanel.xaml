<?xml version="1.0" encoding="UTF-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
        xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
        x:Class="Here.Explore.Maui.RefApp.Controls.MapObjectsPanel"
        x:Name="This"
        StrokeShape="RoundRectangle 16"
        Background="White"
        Padding="12">
    <Border.Shadow>
        <Shadow Brush="#50000000" Offset="0,4" Radius="16" />
    </Border.Shadow>

    <VerticalStackLayout Spacing="8">
        <Label Text="Map Objects"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="#888888"
               HorizontalOptions="Center"
               Margin="0,0,0,4" />

        <!-- Drawing mode selector -->
        <Label Text="Drawing Mode"
               FontSize="11"
               FontAttributes="Bold"
               TextColor="#888888"
               HorizontalOptions="Center"
               Margin="0,0,0,4" />
        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <Button x:Name="DrawMarkerButton"
                    Text="📍"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="#E3F2FD"
                    TextColor="#1976D2"
                    CornerRadius="20"
                    Clicked="OnDrawMarkerClicked"
                    FontSize="16"
                    Padding="0" />
            <Button x:Name="DrawPolylineButton"
                    Text="〰️"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="#E8F5E9"
                    TextColor="#388E3C"
                    CornerRadius="20"
                    Clicked="OnDrawPolylineClicked"
                    FontSize="16"
                    Padding="0" />
            <Button x:Name="DrawPolygonButton"
                    Text="▧"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="#F3E5F5"
                    TextColor="#7B1FA2"
                    CornerRadius="20"
                    Clicked="OnDrawPolygonClicked"
                    FontSize="16"
                    Padding="0" />
            <Button x:Name="CancelDrawButton"
                    Text="✕"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="#FFEBEE"
                    TextColor="#D32F2F"
                    CornerRadius="20"
                    Clicked="OnCancelDrawingClicked"
                    FontSize="16"
                    Padding="0" />
        </HorizontalStackLayout>

        <BoxView HeightRequest="1"
                BackgroundColor="#EEEEEE"
                HorizontalOptions="Fill"
                Margin="0,4" />

        <!-- Demo shapes toggle -->
        <Label Text="Demo Shapes"
               FontSize="11"
               FontAttributes="Bold"
               TextColor="#888888"
               HorizontalOptions="Center"
               Margin="0,0,0,4" />
        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <Button x:Name="MarkersButton"
                    Text="📍"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#E3F2FD"
                    TextColor="#1976D2"
                    CornerRadius="22"
                    Command="{Binding ToggleMarkersCommand, Source={x:Reference This}}"
                    FontSize="20"
                    Padding="0">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <Button x:Name="CirclesButton"
                    Text="⭕"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#FFF3E0"
                    TextColor="#F57C00"
                    CornerRadius="22"
                    Command="{Binding ToggleCirclesCommand, Source={x:Reference This}}"
                    FontSize="20"
                    Padding="0">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <Button x:Name="PolylinesButton"
                    Text="〰️"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#E8F5E9"
                    TextColor="#388E3C"
                    CornerRadius="22"
                    Command="{Binding TogglePolylinesCommand, Source={x:Reference This}}"
                    FontSize="20"
                    Padding="0">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <Button x:Name="PolygonsButton"
                    Text="▧"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#F3E5F5"
                    TextColor="#7B1FA2"
                    CornerRadius="22"
                    Command="{Binding TogglePolygonsCommand, Source={x:Reference This}}"
                    FontSize="20"
                    Padding="0">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
        </HorizontalStackLayout>

        <BoxView HeightRequest="1"
                BackgroundColor="#EEEEEE"
                HorizontalOptions="Fill"
                Margin="0,4" />

        <Button x:Name="ClearAllButton"
                Text="Clear All"
                BackgroundColor="Transparent"
                TextColor="#D32F2F"
                FontSize="12"
                FontAttributes="Bold"
                Padding="8,4"
                HorizontalOptions="Center"
                Command="{Binding ClearAllCommand, Source={x:Reference This}}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.7" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>
    </VerticalStackLayout>
</Border>