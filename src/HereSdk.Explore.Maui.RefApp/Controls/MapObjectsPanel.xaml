<?xml version="1.0" encoding="UTF-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="Here.Explore.Maui.RefApp.Controls.MapObjectsPanel"
        x:Name="This"
        StrokeShape="RoundRectangle 16"
        Background="White"
        Padding="12"
        Margin="0,0,16,16"
        HorizontalOptions="End"
        VerticalOptions="End"
        IsVisible="{Binding PanelVisible, Source={x:Reference This}}">
    <Border.Shadow>
        <Shadow Brush="#50000000" Offset="0,4" Radius="16" />
    </Border.Shadow>

    <VerticalStackLayout Spacing="8">
        <Label Text="Map Objects"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="#888888"
               HorizontalOptions="Center"
               Margin="0,0,0,4" />

        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <Button Text="📍"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#E3F2FD"
                    TextColor="#1976D2"
                    CornerRadius="22"
                    Command="{Binding ToggleMarkersCommand, Source={x:Reference This}}"
                    FontSize="20"
                    Padding="0" />
            <Button Text="⭕"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#FFF3E0"
                    TextColor="#F57C00"
                    CornerRadius="22"
                    Command="{Binding ToggleCirclesCommand, Source={x:Reference This}}"
                    FontSize="20"
                    Padding="0" />
            <Button Text="〰️"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#E8F5E9"
                    TextColor="#388E3C"
                    CornerRadius="22"
                    Command="{Binding TogglePolylinesCommand, Source={x:Reference This}}"
                    FontSize="20"
                    Padding="0" />
            <Button Text="▧"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#F3E5F5"
                    TextColor="#7B1FA2"
                    CornerRadius="22"
                    Command="{Binding TogglePolygonsCommand, Source={x:Reference This}}"
                    FontSize="20"
                    Padding="0" />
        </HorizontalStackLayout>

        <BoxView HeightRequest="1"
                BackgroundColor="#EEEEEE"
                HorizontalOptions="Fill"
                Margin="0,4" />

        <Button Text="Clear All"
                BackgroundColor="Transparent"
                TextColor="#D32F2F"
                FontSize="12"
                FontAttributes="Bold"
                Padding="8,4"
                HorizontalOptions="Center"
                Command="{Binding ClearAllCommand, Source={x:Reference This}}" />
    </VerticalStackLayout>
</Border>