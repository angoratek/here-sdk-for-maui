<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Here.Explore.Maui.RefApp.Controls.CategoryChipBar">
    <Border StrokeShape="RoundRectangle 20"
            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}"
            StrokeThickness="0" Padding="8,6">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                    Offset="0,2" Radius="8" />
        </Border.Shadow>
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="ChipsContainer" x:FieldModifier="public" Spacing="8" />
        </ScrollView>
    </Border>
</ContentView>
