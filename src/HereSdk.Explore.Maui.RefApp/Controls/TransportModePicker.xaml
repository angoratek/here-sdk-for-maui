<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Here.Explore.Maui.RefApp.Controls.TransportModePicker">
    <Border StrokeShape="RoundRectangle 24"
            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}"
            StrokeThickness="0" Padding="10,8">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                    Offset="0,4" Radius="14" />
        </Border.Shadow>
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="ModesContainer" Spacing="8" />
        </ScrollView>
    </Border>
</ContentView>