<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Here.Explore.Maui.RefApp.Controls.TransportModePicker">
    <Border StrokeShape="RoundRectangle 20"
            BackgroundColor="{AppThemeBinding Light=#F2F2F7CC, Dark=#2C2C2ECC}"
            StrokeThickness="0" Padding="8,6">
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="ModesContainer" Spacing="8" />
        </ScrollView>
    </Border>
</ContentView>
