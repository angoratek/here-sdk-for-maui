<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Here.Explore.Maui.RefApp.Controls.EmptyStateView"
             x:Name="EmptyState">
    <VerticalStackLayout Spacing="8"
                         HorizontalOptions="Center" VerticalOptions="Center"
                         Padding="24">
        <Label FontSize="40"
               HorizontalOptions="Center"
               Text="{Binding Source={x:Reference EmptyState}, Path=Icon}" />
        <Label FontSize="17" FontAttributes="Bold"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"
               Text="{Binding Source={x:Reference EmptyState}, Path=Title}"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Label FontSize="14"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"
               Text="{Binding Source={x:Reference EmptyState}, Path=Subtitle}"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
    </VerticalStackLayout>
</ContentView>
