<?xml version="1.0" encoding="UTF-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
        x:Class="Here.Explore.Maui.RefApp.Controls.SearchOverlay"
        StrokeShape="RoundRectangle 16"
        Background="White"
        Padding="0"
        Margin="16,16,16,8"
        HorizontalOptions="Fill"
        VerticalOptions="Start">
    <Border.Shadow>
        <Shadow Brush="#40000000" Offset="0,4" Radius="16" />
    </Border.Shadow>

    <Border.GestureRecognizers>
        <TapGestureRecognizer Command="{Binding FocusSearchCommand}" />
    </Border.GestureRecognizers>

    <Grid ColumnDefinitions="48,*,48" Padding="4" BackgroundColor="White">
        <!-- Search icon -->
        <Label Grid.Column="0"
               Text="🔍"
               FontSize="18"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Opacity="0.6" />

        <!-- Search input -->
        <SearchBar x:Name="SearchBar"
                   Grid.Column="1"
                   Placeholder="Search places..."
                   Text="{Binding SearchQuery, Mode=TwoWay}"
                   SearchCommand="{Binding SearchCommand}"
                   CancelButtonColor="#2196F3"
                   BackgroundColor="Transparent"
                   VerticalOptions="Center"
                   HeightRequest="44" />

        <!-- Clear button -->
        <Button Grid.Column="2"
                Text="✕"
                WidthRequest="32"
                HeightRequest="32"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                BackgroundColor="Transparent"
                Command="{Binding ClearSearchCommand}"
                Opacity="0.5"
                Padding="0"
                FontSize="16">
            <Button.Triggers>
                <DataTrigger TargetType="Button"
                             Binding="{Binding SearchQuery, FallbackValue=''}"
                             Value="{x:Null}">
                    <Setter Property="Opacity" Value="0" />
                </DataTrigger>
                <DataTrigger TargetType="Button"
                             Binding="{Binding SearchQuery, FallbackValue=''}"
                             Value="">
                    <Setter Property="Opacity" Value="0" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>

    <!-- Search results list -->
    <local:SearchResultsList
        x:Name="ResultsList"
        Suggestions="{Binding Suggestions}"
        HasResults="{Binding HasResults}"
        ItemSelectedCommand="{Binding SelectSuggestionCommand}"
        VerticalOptions="Start"
        Margin="16,60,16,0" />
</Border>
