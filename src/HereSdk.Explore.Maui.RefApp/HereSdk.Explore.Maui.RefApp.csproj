<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <OutputType>Exe</OutputType>
    <RootNamespace>Here.Explore.Maui.RefApp</RootNamespace>
    <ApplicationId>com.here.explore.maui.refapp</ApplicationId>
    <ApplicationTitle>HERE SDK Explore Demo</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('android'))">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HereSdk.Explore.Maui\HereSdk.Explore.Maui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <MauiAsset Include="appsettings*.json" />
  </ItemGroup>
</Project>