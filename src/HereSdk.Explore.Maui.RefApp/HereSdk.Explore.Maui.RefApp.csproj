<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <OutputType>Exe</OutputType>
    <RootNamespace>Here.Explore.Maui.RefApp</RootNamespace>
    <ApplicationId>com.here.explore.maui.refapp</ApplicationId>
    <ApplicationTitle>HERE SDK Explore Demo</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('android'))">
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('ios'))">
    <UseInterpreter>true</UseInterpreter>
    <MtouchInterpreter>all,-Microsoft.Maui.Controls.Xaml</MtouchInterpreter>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HereSdk.Explore.Maui\HereSdk.Explore.Maui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- appsettings.json is both an embedded resource AND a MAUI asset -->
    <EmbeddedResource Include="appsettings.json" />
    <MauiAsset Include="appsettings.json" />
    <MauiAsset Include="appsettings.Development.json" />
  </ItemGroup>
</Project>