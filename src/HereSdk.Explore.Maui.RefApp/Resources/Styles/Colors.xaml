<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================ -->
    <!-- BRAND — Airbnb-inspired coral on warm neutrals               -->
    <!-- ============================================================ -->
    <Color x:Key="Primary">#FF385C</Color>
    <Color x:Key="PrimaryDark">#FF5A77</Color>
    <Color x:Key="PrimaryPressed">#E00B41</Color>
    <Color x:Key="PrimaryPressedDark">#FF7590</Color>
    <Color x:Key="Secondary">#00A699</Color>
    <Color x:Key="SecondaryDark">#1FC7BC</Color>

    <!-- Accent palette -->
    <Color x:Key="AccentPurple">#7C5CD6</Color>
    <Color x:Key="AccentPink">#FF385C</Color>
    <Color x:Key="AccentTeal">#26C6DA</Color>
    <Color x:Key="AccentGreen">#2FBF71</Color>

    <!-- Brand gradients (place-card hero, chips) -->
    <Color x:Key="HeroGradientStart">#FF7A59</Color>
    <Color x:Key="HeroGradientEnd">#FF385C</Color>
    <Color x:Key="HeroGradientStartDark">#B25268</Color>
    <Color x:Key="HeroGradientEndDark">#8E2A47</Color>

    <!-- ============================================================ -->
    <!-- SURFACE HIERARCHY — warm, slightly cool-free grays           -->
    <!-- ============================================================ -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1C1C1E</Color>
    <Color x:Key="SurfaceSecondary">#F7F7F7</Color>
    <Color x:Key="SurfaceSecondaryDark">#2C2C2E</Color>
    <Color x:Key="SurfaceTertiary">#EBEBEB</Color>
    <Color x:Key="SurfaceTertiaryDark">#3A3A3C</Color>

    <!-- Background -->
    <Color x:Key="Background">#F7F7F7</Color>
    <Color x:Key="BackgroundDark">#0F0F10</Color>

    <!-- ============================================================ -->
    <!-- TEXT HIERARCHY                                               -->
    <!-- ============================================================ -->
    <Color x:Key="TextPrimary">#222222</Color>
    <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#6A6A6A</Color>
    <Color x:Key="TextSecondaryDark">#B5B5BA</Color>
    <Color x:Key="TextTertiary">#B0B0B3</Color>
    <Color x:Key="TextTertiaryDark">#545456</Color>

    <!-- ============================================================ -->
    <!-- STATUS COLORS                                                -->
    <!-- ============================================================ -->
    <Color x:Key="SuccessGreen">#2FBF71</Color>
    <Color x:Key="ErrorRed">#E33B4E</Color>
    <Color x:Key="WarningOrange">#F5A623</Color>
    <Color x:Key="InfoBlue">#0A7AFF</Color>

    <!-- Place category colors (chip / marker tints) -->
    <Color x:Key="CategoryRestaurant">#FF7A59</Color>
    <Color x:Key="CategoryHotel">#7C5CD6</Color>
    <Color x:Key="CategoryParking">#8E8E93</Color>
    <Color x:Key="CategoryFuel">#0A7AFF</Color>
    <Color x:Key="CategoryHospital">#E33B4E</Color>
    <Color x:Key="CategoryAttraction">#2FBF71</Color>
    <Color x:Key="CategoryShopping">#FF5B8A</Color>
    <Color x:Key="CategoryBank">#279E8F</Color>

    <!-- Traffic jam factor colors -->
    <Color x:Key="TrafficFreeFlow">#2FBF71</Color>
    <Color x:Key="TrafficModerate">#F5C518</Color>
    <Color x:Key="TrafficHeavy">#FF385C</Color>
    <Color x:Key="TrafficClosed">#1C1C1E</Color>

    <!-- Transport mode colors -->
    <Color x:Key="TransportCar">#0A7AFF</Color>
    <Color x:Key="TransportTruck">#F5A623</Color>
    <Color x:Key="TransportPedestrian">#2FBF71</Color>
    <Color x:Key="TransportBicycle">#7C5CD6</Color>
    <Color x:Key="TransportScooter">#FF385C</Color>
    <Color x:Key="TransportBus">#0A7AFF</Color>
    <Color x:Key="TransportTaxi">#F5C518</Color>
    <Color x:Key="TransportTransit">#26C6DA</Color>

    <!-- ============================================================ -->
    <!-- SHELL / TAB BAR                                              -->
    <!-- ============================================================ -->
    <Color x:Key="TabBarBackground">#FFFFFF</Color>
    <Color x:Key="TabBarBackgroundDark">#1C1C1E</Color>
    <Color x:Key="TabSelected">#FF385C</Color>
    <Color x:Key="TabSelectedDark">#FF5A77</Color>
    <Color x:Key="TabUnselected">#8E8E93</Color>
    <Color x:Key="TabUnselectedDark">#7C7C80</Color>

    <!-- Shadow tokens (soft, diffuse modern elevation) -->
    <Color x:Key="ShadowColor">#26000000</Color>
    <Color x:Key="ShadowColorDark">#88000000</Color>
    <Color x:Key="ShadowColorSubtle">#14000000</Color>

    <!-- Handle / separator -->
    <Color x:Key="HandleColor">#E1E1E4</Color>
    <Color x:Key="HandleColorDark">#48484A</Color>
    <Color x:Key="SeparatorColor">#EDEDED</Color>
    <Color x:Key="SeparatorColorDark">#333336</Color>

    <!-- Overlay -->
    <Color x:Key="OverlayDark">#80000000</Color>
    <Color x:Key="OverlayLight">#40FFFFFF</Color>

    <!-- Skeleton shimmer placeholders -->
    <Color x:Key="SkeletonBase">#EEEEEE</Color>
    <Color x:Key="SkeletonHighlight">#F9F9F9</Color>
    <Color x:Key="SkeletonBaseDark">#2A2A2C</Color>
    <Color x:Key="SkeletonHighlightDark">#353538</Color>

    <!-- Opacity variants (for layered effects) -->
    <Color x:Key="Primary10">#1AFF385C</Color>
    <Color x:Key="Primary30">#4DFF385C</Color>
    <Color x:Key="ErrorRed10">#1AE33B4E</Color>
    <Color x:Key="SurfaceWhite50">#80FFFFFF</Color>

    <!-- Error banner (soft red, not yellow) -->
    <Color x:Key="BannerErrorBg">#FFE9EC</Color>
    <Color x:Key="BannerErrorBgDark">#3A1F24</Color>
    <Color x:Key="BannerErrorText">#8A1B2E</Color>
    <Color x:Key="BannerErrorTextDark">#FFC1CB</Color>

    <!-- Floating toolbar / scrim (drawing toolbar, sheet backdrop) -->
    <Color x:Key="ToolbarBackground">#FFFFFF</Color>
    <Color x:Key="ToolbarBackgroundDark">#1C1C1E</Color>
    <Color x:Key="Scrim">#59000000</Color>
    <Color x:Key="IconMuted">#B0B0B3</Color>
    <Color x:Key="IconMutedDark">#545456</Color>
</ResourceDictionary>