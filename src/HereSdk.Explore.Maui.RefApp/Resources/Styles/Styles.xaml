<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================ -->
    <!-- SPACING TOKENS                                               -->
    <!-- ============================================================ -->
    <x:Double x:Key="Space04">4</x:Double>
    <x:Double x:Key="Space06">6</x:Double>
    <x:Double x:Key="Space08">8</x:Double>
    <x:Double x:Key="Space10">10</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space20">20</x:Double>
    <x:Double x:Key="Space24">24</x:Double>

    <!-- ============================================================ -->
    <!-- RADIUS TOKENS                                                -->
    <!-- ============================================================ -->
    <x:Double x:Key="Radius08">8</x:Double>
    <x:Double x:Key="Radius12">12</x:Double>
    <x:Double x:Key="Radius16">16</x:Double>
    <x:Double x:Key="Radius20">20</x:Double>
    <x:Double x:Key="RadiusFull">9999</x:Double>

    <!-- ============================================================ -->
    <!-- TYPOGRAPHY SCALE                                             -->
    <!-- ============================================================ -->
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Callout" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Subheadline" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <!-- ============================================================ -->
    <!-- INPUT STYLES                                                 -->
    <!-- ============================================================ -->
    <Style x:Key="EntryField" TargetType="Entry">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="ClearButtonVisibility" Value="Never" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Search field with leading icon -->
    <Style x:Key="SearchEntry" TargetType="Entry" BasedOn="{StaticResource EntryField}">
        <Setter Property="Placeholder" Value="Search places, addresses..." />
        <Setter Property="ReturnType" Value="Search" />
    </Style>

    <!-- ============================================================ -->
    <!-- BUTTON STYLES                                                -->
    <!-- ============================================================ -->

    <!-- Map floating button (circular, shadowed) -->
    <Style x:Key="MapFloatingButton" TargetType="Button">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,2" Radius="8" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.7" />
                            <Setter Property="Scale" Value="0.95" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Primary action button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Ghost / subtle button -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Chip / segmented button -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Destructive (small) button -->
    <Style x:Key="DestructiveButtonSmall" TargetType="Button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorRed}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- ============================================================ -->
    <!-- SAFE-AREA / TOP MARGIN                                       -->
    <!-- ============================================================ -->
    <!-- iOS MAUI ContentPage already applies the system safe-area
         inset when used inside a Shell, so 60 dp is the total margin
         needed. Android's status bar is 24-30 dp, so 12 dp + system
         inset is enough. Centralising the value here means future
         status-bar / Dynamic-Island changes are a one-line edit. -->
    <!-- NOTE: MAUI already applies the iOS safe-area inset to ContentPage, so the
         top margin only needs the visual gap below the status bar. -->
    <OnPlatform x:Key="TopSafeMargin" x:TypeArguments="Thickness">
        <On Platform="iOS" Value="12,8,12,0" />
        <On Platform="Android" Value="12,12,12,0" />
    </OnPlatform>

    <!-- ============================================================ -->
    <!-- CARD STYLES                                                  -->
    <!-- ============================================================ -->

    <!-- Elevated card with rounded corners and shadow -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,2" Radius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact card with tighter padding -->
    <Style x:Key="CompactCardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,1" Radius="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset card (no shadow, secondary surface) -->
    <Style x:Key="InsetCardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSecondary}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <!-- ============================================================ -->
    <!-- PILL / CHIP STYLES                                           -->
    <!-- ============================================================ -->
    <Style x:Key="PillChip" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondary}}" />
    </Style>

    <!-- ============================================================ -->
    <!-- BOTTOM SHEET STYLE                                           -->
    <!-- ============================================================ -->
    <Style x:Key="BottomSheetBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 24,24,0,0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,-4" Radius="24" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- CONTENT LABEL STYLES                                         -->
    <!-- ============================================================ -->

    <!-- Section header label (uppercase, tracked) -->
    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="Margin" Value="16,16,16,4" />
    </Style>

    <!-- Loading overlay -->
    <Style x:Key="LoadingOverlay" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource OverlayDark}" />
    </Style>

</ResourceDictionary>
