<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================ -->
    <!-- FONT FAMILIES                                                -->
    <!-- ============================================================ -->
    <x:String x:Key="FontRegular">InterRegular</x:String>
    <x:String x:Key="FontMedium">InterMedium</x:String>
    <x:String x:Key="FontSemiBold">InterSemiBold</x:String>
    <x:String x:Key="FontBold">InterBold</x:String>

    <!-- ============================================================ -->
    <!-- IMPLICIT STYLES — app-wide defaults so panels stay consistent.
         Keyed styles MUST be BasedOn these (an explicit style suppresses
         the implicit one in MAUI). -->
    <!-- ============================================================ -->
    <Style x:Key="BaseLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />

    <Style x:Key="BaseEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />
    </Style>
    <Style TargetType="Entry" BasedOn="{StaticResource BaseEntry}" />

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

    <!-- ============================================================ -->
    <!-- SPACING TOKENS                                               -->
    <!-- ============================================================ -->
    <x:Double x:Key="Space04">4</x:Double>
    <x:Double x:Key="Space06">6</x:Double>
    <x:Double x:Key="Space08">8</x:Double>
    <x:Double x:Key="Space10">10</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space20">20</x:Double>
    <x:Double x:Key="Space24">24</x:Double>

    <!-- ============================================================ -->
    <!-- RADIUS TOKENS                                                -->
    <!-- ============================================================ -->
    <x:Double x:Key="Radius08">8</x:Double>
    <x:Double x:Key="Radius12">12</x:Double>
    <x:Double x:Key="Radius16">16</x:Double>
    <x:Double x:Key="Radius20">20</x:Double>
    <x:Double x:Key="RadiusFull">9999</x:Double>

    <!-- ============================================================ -->
    <!-- TYPOGRAPHY SCALE (Inter)                                     -->
    <!-- ============================================================ -->
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.2" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="Body" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Callout" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Subheadline" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Headline" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Title" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="TitleLarge" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="EtaHero" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="CharacterSpacing" Value="-0.8" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <!-- ============================================================ -->
    <!-- INPUT STYLES                                                 -->
    <!-- ============================================================ -->
    <Style x:Key="EntryField" TargetType="Entry" BasedOn="{StaticResource BaseEntry}">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="ClearButtonVisibility" Value="Never" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Search field with leading icon -->
    <Style x:Key="SearchEntry" TargetType="Entry" BasedOn="{StaticResource EntryField}">
        <Setter Property="Placeholder" Value="Search places, addresses..." />
        <Setter Property="ReturnType" Value="Search" />
    </Style>

    <!-- ============================================================ -->
    <!-- BUTTON STYLES                                                -->
    <!-- ============================================================ -->

    <!-- Map floating button (circular, shadowed) -->
    <Style x:Key="MapFloatingButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,2" Radius="10" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.7" />
                            <Setter Property="Scale" Value="0.95" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Primary action button -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="CornerRadius" Value="23" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryPressed}, Dark={StaticResource PrimaryPressedDark}}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Large pill CTA (Airbnb-style full-width) -->
    <Style x:Key="LargePillButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="CornerRadius" Value="25" />
    </Style>

    <!-- Ghost / subtle button -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Chip / segmented button -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Destructive (small) button -->
    <Style x:Key="DestructiveButtonSmall" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorRed}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- ============================================================ -->
    <!-- SAFE-AREA / TOP MARGIN                                       -->
    <!-- ============================================================ -->
    <!-- iOS MAUI ContentPage already applies the system safe-area
         inset when used inside a Shell, so 60 dp is the total margin
         needed. Android's status bar is 24-30 dp, so 12 dp + system
         inset is enough. Centralising the value here means future
         status-bar / Dynamic-Island changes are a one-line edit. -->
    <!-- NOTE: MAUI already applies the iOS safe-area inset to ContentPage, so the
         top margin only needs the visual gap below the status bar. -->
    <OnPlatform x:Key="TopSafeMargin" x:TypeArguments="Thickness">
        <On Platform="iOS" Value="12,8,12,0" />
        <On Platform="Android" Value="12,12,12,0" />
    </OnPlatform>

    <!-- ============================================================ -->
    <!-- CARD STYLES                                                  -->
    <!-- ============================================================ -->

    <!-- Elevated card with rounded corners and shadow -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,2" Radius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact card with tighter padding -->
    <Style x:Key="CompactCardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColorSubtle}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,1" Radius="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Floating result card (carousel) — larger radius, stronger shadow -->
    <Style x:Key="ResultCardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,6" Radius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset card (no shadow, secondary surface) -->
    <Style x:Key="InsetCardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSecondary}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <!-- ============================================================ -->
    <!-- PILL / CHIP STYLES                                           -->
    <!-- ============================================================ -->
    <Style x:Key="PillChip" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SeparatorColor}, Dark={StaticResource SeparatorColorDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondary}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColorSubtle}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,2" Radius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Floating search pill (Explore "Where to?") -->
    <Style x:Key="SearchPillBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
        <Setter Property="StrokeThickness" Value="0" />
        <!-- No fixed HeightRequest: an Android Entry needs ~45px and would be
             clipped inside a 52px pill with vertical padding; size to content instead. -->
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,4" Radius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- ICON STYLES                                                  -->
    <!-- ============================================================ -->

    <!-- Material icon glyph inside a small tinted circle (category badges) -->
    <Style x:Key="CategoryIconLabel" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ -->
    <!-- SHEET / FLOATING-TOOLBAR STYLES                              -->
    <!-- ============================================================ -->

    <!-- Card row inside a bottom sheet (object list, route sections) -->
    <Style x:Key="SheetCardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSecondary}, Dark={StaticResource SurfaceSecondaryDark}}" />
    </Style>

    <!-- Floating hint pill over the map (drawing hints) -->
    <Style x:Key="HintPillBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,2" Radius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool pill on the floating drawing toolbar -->
    <Style x:Key="FloatingToolButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <!-- Standard list row (48dp min height, consistent inset) -->
    <Style x:Key="ListRow" TargetType="Grid">
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="ColumnDefinitions" Value="Auto,*,Auto" />
    </Style>

    <!-- ============================================================ -->
    <!-- CONTENT LABEL STYLES                                         -->
    <!-- ============================================================ -->

    <!-- Section header label (uppercase, tracked) -->
    <Style x:Key="SectionHeader" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="Margin" Value="16,16,16,4" />
    </Style>

    <!-- Loading overlay -->
    <Style x:Key="LoadingOverlay" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

</ResourceDictionary>