<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Here.Explore.Maui.Models.Search;assembly=HereSdk.Explore.Maui"
             xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             xmlns:converters="clr-namespace:Here.Explore.Maui.RefApp.Converters"
             x:Class="Here.Explore.Maui.RefApp.Panels.ExplorePanel"
             x:DataType="viewmodels:ExploreViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:BoolToOpenColorConverter x:Key="BoolToOpenColor" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Overlays over the shared map (the HereMapView itself lives in MapHomePage).
         InputTransparent is NOT set: the search pill and cards must stay tappable. -->
    <Grid x:Name="RootGrid" RowDefinitions="*">
        <!-- Top search area -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="{StaticResource TopSafeMargin}"
                             VerticalOptions="Start">

            <!-- Search error banner (also shows offline message) -->
            <local:ErrorBanner ErrorMessage="{Binding SearchErrorMessage}"
                               RetryCommand="{Binding SubmitSearchCommand}"
                               RetryText="Retry" />

            <!-- HERE SDK: SearchEntry binds to ExploreViewModel.SubmitSearchCommand → ISearchService.SearchAsync().
                 Suggestions populate from SearchEngine.suggest() results bound via ExploreViewModel.Suggestions. -->
            <Border Style="{StaticResource SearchPillBorder}" Padding="18,10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" FontFamily="MaterialIcons" Text="&#xe8b6;" FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           AutomationId="ExploreSearchEntry"
                           SemanticProperties.Hint="Enter a place name or address to search"
                           Style="{StaticResource SearchEntry}"
                           Placeholder="Where to?"
                           Text="{Binding SearchQuery, Mode=TwoWay}"
                           VerticalOptions="Center"
                           ReturnCommand="{Binding SubmitSearchCommand}" />
                    <Button Grid.Column="2"
                            FontFamily="MaterialIcons" Text="&#xe5cd;" FontSize="16"
                            Style="{StaticResource MapFloatingButton}"
                            WidthRequest="32" HeightRequest="32" CornerRadius="16"
                            IsVisible="{Binding SearchQuery.Length, Converter={StaticResource InverseBool}}"
                            Command="{Binding ClearSearchCommand}"
                            AutomationId="ExploreClearSearchButton"
                            VerticalOptions="Center" Margin="0,0,2,0" />
                </Grid>
            </Border>

            <!-- Suggestions dropdown -->
            <Border Style="{StaticResource CardBorder}" Padding="4"
                    IsVisible="{Binding HasSuggestions}">
                <CollectionView ItemsSource="{Binding Suggestions}"
                                SelectionMode="Single"
                                HeightRequest="240">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Suggestion">
                            <Grid Padding="14,10" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34"
                                        StrokeShape="RoundRectangle 17" StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary10}, Dark={StaticResource Primary30}}"
                                        VerticalOptions="Center">
                                    <Label FontFamily="MaterialIcons" Text="&#xe55f;" FontSize="17"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="{Binding Title}" FontSize="15" FontFamily="InterSemiBold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding Type}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExploreViewModel}}, Path=SelectSuggestionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Category chips (shown when not searching) -->
            <local:CategoryChipBar x:Name="CategoryChips"
                                   IsVisible="{Binding HasSuggestions, Converter={StaticResource InverseBool}}" />
        </VerticalStackLayout>

        <!-- Empty state (no results) -->
        <local:EmptyStateView Grid.Row="0"
                               Icon="🔍"
                               Title="{Binding EmptyStateTitle}"
                               Subtitle="{Binding EmptyStateSubtitle}" />

        <!-- Results carousel (bottom) — tap a card to open its place card -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding SearchResults}"
                        IsVisible="{Binding HasSearchResults}"
                        HeightRequest="118"
                        VerticalOptions="End" HorizontalOptions="Fill"
                        Margin="12,0,12,64">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ExploreViewModel+SearchResultItem">
                    <Border Style="{StaticResource ResultCardBorder}" Padding="12"
                            WidthRequest="172" VerticalOptions="Fill">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExploreViewModel}}, Path=SelectResultCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 19" StrokeThickness="0"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{Binding CategoryColor, TargetNullValue={StaticResource Primary}, FallbackValue={StaticResource Primary}}">
                                <Label FontFamily="MaterialIcons" Text="{Binding CategoryGlyph}" FontSize="19"
                                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="14"
                                   MaxLines="2" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="{Binding DistanceText}" FontFamily="InterMedium" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Floating map buttons (right side, vertically centered) -->
        <VerticalStackLayout Grid.Row="0" Spacing="10"
                             VerticalOptions="End" HorizontalOptions="End"
                             Margin="0,0,12,72">
            <Button FontFamily="MaterialIcons" Text="&#xe145;" FontSize="18"
                    Style="{StaticResource MapFloatingButton}"
                    AutomationId="ExploreZoomInButton"
                    Command="{Binding ZoomInCommand}" />
            <Button FontFamily="MaterialIcons" Text="&#xe15b;" FontSize="18"
                    Style="{StaticResource MapFloatingButton}"
                    AutomationId="ExploreZoomOutButton"
                    Command="{Binding ZoomOutCommand}" />
            <Button FontFamily="MaterialIcons" Text="&#xe55c;" FontSize="18"
                    Style="{StaticResource MapFloatingButton}"
                    AutomationId="ExploreCenterOnLocationButton"
                    Command="{Binding CenterOnLocationCommand}" />
        </VerticalStackLayout>

        <!-- Map style picker (bottom-right) -->
        <local:MapStylePicker x:Name="StylePicker" Grid.Row="0"
                              AutomationId="ExploreMapStylePicker"
                              VerticalOptions="End" HorizontalOptions="End"
                              Margin="0,0,12,12" />

        <!-- HERE SDK: PlaceCard displays a SearchResult Place (title, address, contact, opening hours).
             Populated after ISearchService.SearchAsync() returns and user taps a suggestion or map marker. -->
        <local:BottomSheet x:Name="PlaceSheet"
                           Grid.Row="0"
                           CollapsedHeight="0"
                           HalfExpandedHeight="340"
                           CurrentState="Collapsed"
                           IsVisible="{Binding IsPlaceCardVisible}">
            <local:BottomSheet.SheetContent>
                <ScrollView>
                    <local:PlaceCard x:Name="PlaceCardView" />
                </ScrollView>
            </local:BottomSheet.SheetContent>
        </local:BottomSheet>
        <!-- Loading indicator: centered pill, map stays interactive -->
        <Grid Grid.Row="0" InputTransparent="True" IsVisible="{Binding IsSearching}">
            <Border HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="18,12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                            Offset="0,4" Radius="16" />
                </Border.Shadow>
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="True"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="Searching…" FontSize="15" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>