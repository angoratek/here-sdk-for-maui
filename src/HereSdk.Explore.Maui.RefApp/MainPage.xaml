<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Here.Explore.Maui.Controls;assembly=HereSdk.Explore.Maui"
             xmlns:models="clr-namespace:Here.Explore.Maui.Models;assembly=HereSdk.Explore.Maui"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             x:Class="Here.Explore.Maui.RefApp.MainPage"
             x:DataType="viewmodels:MapViewModel"
             Title="HERE SDK Explore"
             BackgroundColor="LightBlue">

    <Grid RowDefinitions="Auto,Auto,*">
        <HorizontalStackLayout Padding="10" Spacing="10">
            <Button Text="Normal Day" Command="{Binding NormalDayCommand}" />
            <Button Text="Satellite" Command="{Binding SatelliteCommand}" />
            <Button Text="Search" Command="{Binding SearchCommand}" />
        </HorizontalStackLayout>

        <Label x:Name="StatusLabel" Grid.Row="1" Text="Loading map..." TextColor="Orange" FontSize="14" FontAttributes="Bold" Padding="10,5" BackgroundColor="White" />

        <controls:HereMapView
            x:Name="MapView"
            Grid.Row="2"
            CameraTarget="{Binding MapCenter}"
            MapScheme="NormalDay" />
    </Grid>
</ContentPage>