<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Here.Explore.Maui.Controls;assembly=HereSdk.Explore.Maui"
             xmlns:models="clr-namespace:Here.Explore.Maui.Models.Search;assembly=HereSdk.Explore.Maui"
             xmlns:routing="clr-namespace:Here.Explore.Maui.Models.Routing;assembly=HereSdk.Explore.Maui"
             xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             xmlns:converters="clr-namespace:Here.Explore.Maui.RefApp.Converters"
             x:Class="Here.Explore.Maui.RefApp.Pages.DirectionsPage"
             x:DataType="viewmodels:DirectionsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:ManeuverActionToIconConverter x:Key="ManeuverIcon" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*">
        <!-- HERE SDK: HereMapView renders the calculated route as a polyline + maneuver markers.
             Access via MapView.Map to add/remove route geometry programmatically. -->
        <controls:HereMapView x:Name="MapView" Grid.Row="0"
                               AutomationId="DirectionsMapView"
                               SemanticProperties.Description="Map showing route and directions" />

        <!-- Top input area -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="{StaticResource TopSafeMargin}"
                             VerticalOptions="Start">

            <!-- Error banner -->
            <local:ErrorBanner ErrorMessage="{Binding RouteError}"
                               RetryCommand="{Binding CalculateRouteCommand}"
                               RetryText="Retry" />

            <!-- HERE SDK: Origin/Destination entries feed IRoutingService.CalculateRouteAsync().
                 Suggestions come from ISearchService.SuggestAsync() for each input field independently. -->
            <Border Style="{StaticResource SearchPillBorder}" Padding="16,8">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="0">

                    <!-- Origin -->
                    <Border Grid.Row="0" Grid.Column="0" WidthRequest="12" HeightRequest="12"
                            StrokeShape="RoundRectangle 6" StrokeThickness="0"
                            BackgroundColor="{StaticResource AccentGreen}"
                            VerticalOptions="Center" HorizontalOptions="Center" Margin="4,0,0,0" />
                    <Entry Grid.Row="0" Grid.Column="1"
                           x:Name="OriginEntry"
                           AutomationId="DirectionsFromEntry"
                           Style="{StaticResource EntryField}"
                           Text="{Binding OriginQuery, Mode=TwoWay}"
                           Placeholder="Origin" Margin="14,8,0,4" />
                    <!-- Origin suggestions -->
                    <CollectionView Grid.Row="1" Grid.Column="1"
                                    ItemsSource="{Binding OriginSuggestions}"
                                    IsVisible="{Binding HasOriginSuggestions}"
                                    HeightRequest="120" SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Suggestion">
                                <Grid Padding="8,6" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label FontFamily="MaterialIcons" Text="&#xe55f;" FontSize="15"
                                           TextColor="{StaticResource AccentGreen}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                           FontFamily="InterRegular" VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DirectionsViewModel}}, Path=SelectOriginSuggestionCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Divider with swap button -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto" Margin="8,4">
                        <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SeparatorColor}, Dark={StaticResource SeparatorColorDark}}"
                                 HorizontalOptions="Fill" VerticalOptions="Center" />
                        <Button Grid.Column="2" FontFamily="MaterialIcons" Text="&#xe8d5;" FontSize="14"
                                WidthRequest="30" HeightRequest="30" CornerRadius="15" Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                BorderWidth="0"
                                Command="{Binding SwapLocationsCommand}"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Destination -->
                    <Border Grid.Row="3" Grid.Column="0" WidthRequest="12" HeightRequest="12"
                            StrokeShape="RoundRectangle 6" StrokeThickness="0"
                            BackgroundColor="{StaticResource Primary}"
                            VerticalOptions="Center" HorizontalOptions="Center" Margin="4,0,0,0" />
                    <Entry Grid.Row="3" Grid.Column="1"
                           x:Name="DestinationEntry"
                           AutomationId="DirectionsToEntry"
                           Style="{StaticResource EntryField}"
                           Text="{Binding DestinationQuery, Mode=TwoWay}"
                           Placeholder="Destination" Margin="14,4,0,8" />
                </Grid>
            </Border>

            <!-- Destination suggestions -->
            <Border Style="{StaticResource CardBorder}" Padding="4"
                    IsVisible="{Binding HasDestinationSuggestions}">
                <CollectionView ItemsSource="{Binding DestinationSuggestions}"
                                HeightRequest="120" SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Suggestion">
                            <Grid Padding="10,8" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label FontFamily="MaterialIcons" Text="&#xe55f;" FontSize="15"
                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                       FontFamily="InterRegular" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DirectionsViewModel}}, Path=SelectDestinationSuggestionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- HERE SDK: TransportModePicker sets RoutingOptions.TransportMode (car, truck, pedestrian, etc.)
                 before calling IRoutingService.CalculateRouteAsync(). -->
            <local:TransportModePicker x:Name="ModePicker" />
        </VerticalStackLayout>

        <!-- Floating buttons (right) -->
        <VerticalStackLayout Grid.Row="0" Spacing="10"
                             VerticalOptions="Center" HorizontalOptions="End"
                             Margin="0,0,12,0">
            <Button FontFamily="MaterialIcons" Text="&#xe55d;" FontSize="18"
                    Style="{StaticResource MapFloatingButton}"
                    AutomationId="DirectionsCalculateButton"
                    Command="{Binding CalculateRouteCommand}"
                    IsVisible="{Binding OriginPlace, Converter={StaticResource InverseBool}}" />

            <!-- Isoline toggle -->
            <Button FontFamily="MaterialIcons" FontSize="18"
                    Style="{StaticResource MapFloatingButton}"
                    AutomationId="DirectionsIsolineButton"
                    Command="{Binding ToggleIsolineModeCommand}"
                    Text="{Binding IsIsolineMode, Converter={StaticResource InverseBool}}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsIsolineMode}" Value="False">
                        <Setter Property="Text" Value="&#xe39e;" />
                        <Setter Property="Style" Value="{StaticResource MapFloatingButton}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsIsolineMode}" Value="True">
                        <Setter Property="Text" Value="&#xe55f;" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Traffic on route -->
            <Button FontFamily="MaterialIcons" Text="&#xe565;" FontSize="18"
                    Style="{StaticResource MapFloatingButton}"
                    Command="{Binding ToggleTrafficOnRouteCommand}"
                    IsVisible="{Binding IsRouteVisible}" />
        </VerticalStackLayout>

        <!-- HERE SDK: Route sheet displays the calculated Route with Sections and Maneuvers.
             Each Maneuver maps to a routing instruction (turn left, continue, etc.) from IRoutingService. -->
        <local:BottomSheet x:Name="RouteSheet" Grid.Row="0"
                           CollapsedHeight="0"
                           HalfExpandedHeight="240"
                           CurrentState="Collapsed"
                           IsVisible="{Binding IsRouteVisible}">
            <local:BottomSheet.SheetContent>
                <ScrollView Padding="20,12,20,16">
                    <VerticalStackLayout Spacing="14">
                        <!-- ETA hero -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <HorizontalStackLayout Spacing="6">
                                    <Label FontFamily="MaterialIcons" Text="&#xe55d;" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding RouteEta}" Style="{StaticResource EtaHero}"
                                           AutomationId="RouteSheetEta" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding RouteDistance}" FontFamily="InterMedium" FontSize="14"
                                       AutomationId="RouteSheetDistance"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Route summary (full, incl. traffic delay when toggled) -->
                        <Label Text="{Binding RouteSummary}" FontFamily="InterMedium" FontSize="12"
                               AutomationId="RouteSheetSummary"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />

                        <!-- Route error -->
                        <Label Text="{Binding RouteError}" FontSize="14" TextColor="{StaticResource ErrorRed}"
                               IsVisible="{Binding RouteError.Length}" AutomationId="RouteErrorLabel" />

                        <!-- Maneuver timeline -->
                        <CollectionView ItemsSource="{Binding Maneuvers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="routing:Section">
                                    <VerticalStackLayout Padding="0,4">
                                        <Label FontFamily="InterSemiBold" FontSize="12" CharacterSpacing="0.8"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} m">
                                                    <Binding Path="TransportMode" />
                                                    <Binding Path="LengthInMeters" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <CollectionView ItemsSource="{Binding Maneuvers}">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="routing:Maneuver">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6" ColumnSpacing="14">
                                                        <!-- Maneuver icon disc -->
                                                        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                                                StrokeShape="RoundRectangle 18" StrokeThickness="0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary10}, Dark={StaticResource Primary30}}"
                                                                VerticalOptions="Start">
                                                            <Label FontFamily="MaterialIcons" FontSize="17"
                                                                   Text="{Binding Action, Converter={StaticResource ManeuverIcon}}"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                                        </Border>
                                                        <Label Grid.Column="1" Text="{Binding Instruction}"
                                                               FontFamily="InterRegular" FontSize="13.5" VerticalOptions="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                        <Label Grid.Column="2" Text="{Binding DistanceText}"
                                                               FontFamily="InterMedium" FontSize="12" VerticalOptions="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>
            </local:BottomSheet.SheetContent>
        </local:BottomSheet>

        <!-- Empty state -->
        <local:EmptyStateView Grid.Row="0"
                               Icon="🛣"
                               Title="{Binding EmptyStateTitle}"
                               Subtitle="{Binding EmptyStateSubtitle}" />

        <!-- Loading indicator: centered pill, map stays interactive -->
        <Grid Grid.Row="0" InputTransparent="True" IsVisible="{Binding IsCalculating}">
            <Border HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="18,12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                            Offset="0,4" Radius="16" />
                </Border.Shadow>
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="True"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="Calculating route…" FontSize="15" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>