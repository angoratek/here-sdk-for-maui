<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             x:Class="Here.Explore.Maui.RefApp.RoutingPage"
             x:DataType="viewmodels:RoutingViewModel"
             Title="Routing">

    <StackLayout Padding="10" Spacing="10">
        <Label Text="Calculate Route" FontSize="24" FontAttributes="Bold" />

        <Label Text="Berlin → Paris" FontSize="14" />

        <Button Text="Calculate Route" Command="{Binding CalculateRouteCommand}" />

        <Label Text="{Binding StatusMessage}" FontSize="14" />
    </StackLayout>
</ContentPage>