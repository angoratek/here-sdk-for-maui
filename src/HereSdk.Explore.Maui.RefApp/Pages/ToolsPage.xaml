<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Here.Explore.Maui.Controls;assembly=HereSdk.Explore.Maui"
             xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             x:Class="Here.Explore.Maui.RefApp.Pages.ToolsPage"
             x:DataType="viewmodels:ToolsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Button style for selected drawing tool -->
            <Style x:Key="DrawingToolButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,2,8,2" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Style>

            <Style x:Key="SchemeChip" TargetType="Button">
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="FontFamily" Value="InterMedium" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,2,8,2" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Style>

            <!-- Collapsible section header chevron -->
            <Style x:Key="SectionChevron" TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />
                <Setter Property="Text" Value="&#xe5cc;" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*">
        <!-- HERE SDK: HereMapView is the target for drawing tools — markers, polylines, polygons, circles
             are added via IMapService.AddMarker(), AddPolyline(), AddPolygon(), AddCircle(). -->
        <controls:HereMapView x:Name="MapView" Grid.Row="0" AutomationId="ToolsMapView" />

        <!-- Drawing mode banner. Visible whenever the tools section
             is expanded; renders the live DrawingHint (set after a tool
             is picked) and a static "how to draw" tip before any tool
             is selected. -->
        <Border Grid.Row="0" Style="{StaticResource SearchPillBorder}" Margin="{StaticResource TopSafeMargin}"
                VerticalOptions="Start" Padding="14,8"
                IsVisible="{Binding IsDrawingExpanded}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" FontFamily="MaterialIcons" Text="&#xe746;" FontSize="18"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1" FontFamily="InterMedium" FontSize="13"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}">
                    <!-- DrawingHint starts as "" (not null), so FallbackValue/TargetNullValue
                         never apply — cover the empty state with a DataTrigger instead. -->
                    <Label.Text>
                        <Binding Path="DrawingHint" FallbackValue="Tip: pick a tool below, then tap the map to draw." TargetNullValue="Tip: pick a tool below, then tap the map to draw." />
                    </Label.Text>
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding DrawingHint}" Value="">
                            <Setter Property="Text" Value="Tip: pick a tool below, then tap the map to draw." />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Button Grid.Column="2" Text="Cancel" FontFamily="InterSemiBold" FontSize="12"
                        HeightRequest="32" CornerRadius="16" Padding="14,0"
                        BackgroundColor="{StaticResource ErrorRed}"
                        TextColor="White"
                        IsVisible="{Binding IsDrawingActive}"
                        Command="{Binding CancelDrawingCommand}" />
            </Grid>
        </Border>

        <!-- Clear All button -->
        <Button Grid.Row="0" Text="Clear All" Style="{StaticResource MapFloatingButton}"
                AutomationId="ToolsClearAllButton"
                FontFamily="InterSemiBold" FontSize="13"
                VerticalOptions="End" HorizontalOptions="End"
                Margin="0,0,12,68" WidthRequest="78"
                Command="{Binding ClearAllCommand}"
                IsVisible="{Binding TotalObjectCount}" />

        <!-- Object count badge -->
        <Border Grid.Row="0" VerticalOptions="End" HorizontalOptions="Center"
                Margin="0,0,0,68" Padding="12,6"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}"
                StrokeShape="RoundRectangle 14" StrokeThickness="0"
                IsVisible="{Binding TotalObjectCount}">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColorSubtle}, Dark={StaticResource ShadowColorDark}}"
                        Offset="0,2" Radius="8" />
            </Border.Shadow>
            <Label Text="{Binding TotalObjectCount, StringFormat='{0} objects on map'}"
                   FontFamily="InterMedium" FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
        </Border>

        <!-- Bottom sheet with tools. Lands fully expanded so the user
             sees the drawing tools and Demo Gallery immediately; the
             "Tap a tool, then tap the map" hint is rendered inside. -->
        <local:BottomSheet x:Name="ToolsSheet" Grid.Row="0"
                           CollapsedHeight="80"
                           HalfExpandedHeight="340"
                           FullyExpandedHeight="640"
                           CurrentState="FullyExpanded">
            <local:BottomSheet.HeaderContent>
                <Grid Padding="16,4" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Tools &amp; Settings" FontFamily="InterBold" FontSize="17"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding TotalObjectCount, StringFormat='{0} objects'}"
                           FontFamily="InterMedium" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           VerticalOptions="Center" />
                </Grid>
            </local:BottomSheet.HeaderContent>

            <local:BottomSheet.SheetContent>
                <ScrollView Padding="16,0">
                    <VerticalStackLayout Spacing="10" Padding="0,0,0,20">

                        <!-- ================================================ -->
                        <!-- DRAWING TOOLS — IMapService.AddMarker/AddPolyline/AddPolygon/AddCircle -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource CardBorder}" Padding="14">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleDrawingExpandedCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="Drawing Tools" FontFamily="InterSemiBold" FontSize="15"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Column="1" Style="{StaticResource SectionChevron}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDrawingExpanded}" Value="True">
                                                <Setter Property="Text" Value="&#xe5cf;" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDrawingExpanded}" Value="False">
                                                <Setter Property="Text" Value="&#xe5cc;" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsDrawingExpanded}">
                                    <Label Text="Select a tool, then tap the map to draw. Double-tap to finish lines &amp; polygons."
                                           FontFamily="InterRegular" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                        <Button Text="Marker" Style="{StaticResource DrawingToolButton}"
                                                AutomationId="ToolsMarkerButton"
                                                Command="{Binding SetDrawingToolCommand}" CommandParameter="Marker">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding CurrentDrawingTool}"
                                                             Value="{x:Static viewmodels:DrawingTool.Marker}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="Polyline" Style="{StaticResource DrawingToolButton}"
                                                AutomationId="ToolsPolylineButton"
                                                Command="{Binding SetDrawingToolCommand}" CommandParameter="Polyline">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding CurrentDrawingTool}"
                                                             Value="{x:Static viewmodels:DrawingTool.Polyline}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="Polygon" Style="{StaticResource DrawingToolButton}"
                                                AutomationId="ToolsPolygonButton"
                                                Command="{Binding SetDrawingToolCommand}" CommandParameter="Polygon">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding CurrentDrawingTool}"
                                                             Value="{x:Static viewmodels:DrawingTool.Polygon}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="Circle" Style="{StaticResource DrawingToolButton}"
                                                AutomationId="ToolsCircleButton"
                                                Command="{Binding SetDrawingToolCommand}" CommandParameter="Circle">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding CurrentDrawingTool}"
                                                             Value="{x:Static viewmodels:DrawingTool.Circle}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ================================================ -->
                        <!-- DEMO GALLERY                                     -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource CardBorder}" Padding="14">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleGalleryExpandedCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="Demo Gallery" FontFamily="InterSemiBold" FontSize="15"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Column="1" Style="{StaticResource SectionChevron}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsGalleryExpanded}" Value="True">
                                                <Setter Property="Text" Value="&#xe5cf;" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsGalleryExpanded}" Value="False">
                                                <Setter Property="Text" Value="&#xe5cc;" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsGalleryExpanded}">
                                    <Label Text="Pre-built demos that showcase SDK rendering capabilities."
                                           FontFamily="InterRegular" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                                    <CollectionView ItemsSource="{Binding DemoPresets}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:DemoPreset">
                                                <Border Style="{StaticResource CompactCardBorder}" Margin="0,3" Padding="12,10">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                        <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                                                StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary10}, Dark={StaticResource Primary30}}"
                                                                VerticalOptions="Center">
                                                            <Label FontFamily="MaterialIcons" Text="&#xe53b;" FontSize="19"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                            <Label Text="{Binding Name}" FontFamily="InterSemiBold" FontSize="14"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                            <Label Text="{Binding Description}" FontFamily="InterRegular" FontSize="11.5"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                        </VerticalStackLayout>
                                                        <Button Grid.Column="2" Text="Add"
                                                                FontFamily="InterSemiBold" FontSize="12"
                                                                HeightRequest="32" CornerRadius="16" Padding="16,0"
                                                                BackgroundColor="{StaticResource Primary}"
                                                                TextColor="White"
                                                                VerticalOptions="Center"
                                                                Command="{Binding ActivateCommand}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ================================================ -->
                        <!-- SETTINGS                                         -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource CardBorder}" Padding="14">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleSettingsExpandedCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="Settings" FontFamily="InterSemiBold" FontSize="15"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Column="1" Style="{StaticResource SectionChevron}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSettingsExpanded}" Value="True">
                                                <Setter Property="Text" Value="&#xe5cf;" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSettingsExpanded}" Value="False">
                                                <Setter Property="Text" Value="&#xe5cc;" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSettingsExpanded}">

                                    <!-- HERE SDK: Map scheme picker — calls IMapService.SetScheme() to switch map style at runtime. -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="MAP STYLE" FontFamily="InterSemiBold" FontSize="11" CharacterSpacing="0.8"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                            <Button Text="Normal Day" Style="{StaticResource SchemeChip}"
                                                    AutomationId="ToolsSchemeNormalDay"
                                                    Command="{Binding ChangeSchemeCommand}" CommandParameter="NormalDay">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedSchemeName}" Value="NormalDay">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <Button Text="Night" Style="{StaticResource SchemeChip}"
                                                    AutomationId="ToolsSchemeNormalNight"
                                                    Command="{Binding ChangeSchemeCommand}" CommandParameter="NormalNight">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedSchemeName}" Value="NormalNight">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <Button Text="Hybrid" Style="{StaticResource SchemeChip}"
                                                    AutomationId="ToolsSchemeHybridDay"
                                                    Command="{Binding ChangeSchemeCommand}" CommandParameter="HybridDay">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedSchemeName}" Value="HybridDay">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <Button Text="Satellite" Style="{StaticResource SchemeChip}"
                                                    AutomationId="ToolsSchemeSatelliteDay"
                                                    Command="{Binding ChangeSchemeCommand}" CommandParameter="SatelliteDay">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedSchemeName}" Value="SatelliteDay">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <Button Text="Terrain" Style="{StaticResource SchemeChip}"
                                                    AutomationId="ToolsSchemeTerrainDay"
                                                    Command="{Binding ChangeSchemeCommand}" CommandParameter="TerrainDay">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedSchemeName}" Value="TerrainDay">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </FlexLayout>
                                    </VerticalStackLayout>

                                    <!-- Dark mode toggle -->
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Dark Mode" FontFamily="InterMedium" FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label Text="Toggle between light and dark appearance"
                                                   FontFamily="InterRegular" FontSize="11.5"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding IsDarkMode, Mode=TwoWay}"
                                                AutomationId="ToolsDarkModeToggle"
                                                OnColor="{StaticResource Primary}" />
                                    </Grid>

                                    <!-- SDK version -->
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary10}, Dark={StaticResource Primary30}}"
                                            Padding="12" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label FontFamily="MaterialIcons" Text="&#xe2db;" FontSize="22"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                   VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="HERE SDK VERSION" FontFamily="InterSemiBold" FontSize="10" CharacterSpacing="0.8"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Label Text="{Binding SdkVersion}" FontFamily="InterBold" FontSize="17"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                <Label Text="Explore Edition" FontFamily="InterRegular" FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Open full settings -->
                                    <Button Text="More Settings" FontFamily="InterSemiBold" FontSize="14"
                                            AutomationId="ToolsMoreSettingsButton"
                                            HeightRequest="46" CornerRadius="23"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            Clicked="OnOpenSettingsClicked" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>
            </local:BottomSheet.SheetContent>
        </local:BottomSheet>
    </Grid>
</ContentPage>