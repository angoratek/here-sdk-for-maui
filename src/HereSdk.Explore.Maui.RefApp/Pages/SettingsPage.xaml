<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             x:Class="Here.Explore.Maui.RefApp.Pages.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSecondary}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="16,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <Button Grid.Column="0"
                    x:Name="BackButton"
                    Text="←"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    FontSize="20"
                    Padding="0"
                    Clicked="OnBackClicked">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <Label Grid.Column="1"
                   Text="Settings"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="8,0,0,0" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- About Card -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="About" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="App Name" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="{Binding AppName}" Style="{StaticResource Body}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="App Version" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource Body}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="HERE SDK Version" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="{Binding HereSdkVersion}" Style="{StaticResource Body}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Build Configuration" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="{Binding BuildConfig}" Style="{StaticResource Body}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Platform" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="{Binding Platform}" Style="{StaticResource Body}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Legal Card -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Legal" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenTermsCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Terms of Use" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="→" Style="{StaticResource Body}" TextColor="{StaticResource Primary}" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Privacy Policy" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="→" Style="{StaticResource Body}" TextColor="{StaticResource Primary}" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SurfaceTertiary}, Dark={StaticResource SurfaceTertiaryDark}}"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SendFeedbackCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Send Feedback" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="✉" Style="{StaticResource Body}" TextColor="{StaticResource Primary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Debug Card -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Debug" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearCacheCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Clear Cache" Style="{StaticResource Body}" />
                            <Label Grid.Column="1" Text="→" Style="{StaticResource Body}" TextColor="{StaticResource ErrorRed}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
