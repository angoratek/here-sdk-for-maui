<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             x:Class="Here.Explore.Maui.RefApp.Pages.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings"
             BackgroundColor="LightBlue">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="16,12"
              BackgroundColor="White">
            <Button Grid.Column="0"
                    x:Name="BackButton"
                    Text="←"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    TextColor="#333333"
                    FontSize="20"
                    Padding="0"
                    Clicked="OnBackClicked">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <Label Grid.Column="1"
                   Text="Settings"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="8,0,0,0" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- About Card -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,2" Radius="8" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="About"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#888888"
                               Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,8">
                            <Label Grid.Column="0"
                                   Text="App Name"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label Grid.Column="1"
                                   Text="{Binding AppName}"
                                   FontSize="14"
                                   TextColor="#666666" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#EEEEEE"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,8">
                            <Label Grid.Column="0"
                                   Text="App Version"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label Grid.Column="1"
                                   Text="{Binding AppVersion}"
                                   FontSize="14"
                                   TextColor="#666666" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#EEEEEE"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,8">
                            <Label Grid.Column="0"
                                   Text="HERE SDK Version"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label Grid.Column="1"
                                   Text="{Binding HereSdkVersion}"
                                   FontSize="14"
                                   TextColor="#666666" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Legal Card -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,2" Radius="8" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Legal"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#888888"
                               Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenTermsCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="Terms of Use"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label Grid.Column="1"
                                   Text="→"
                                   FontSize="14"
                                   TextColor="#2196F3" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#EEEEEE"
                                 HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="Privacy Policy"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label Grid.Column="1"
                                   Text="→"
                                   FontSize="14"
                                   TextColor="#2196F3" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Debug Card -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,2" Radius="8" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Debug"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#888888"
                               Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearCacheCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="Clear Cache"
                                   FontSize="14"
                                   TextColor="#333333" />
                            <Label Grid.Column="1"
                                   Text="→"
                                   FontSize="14"
                                   TextColor="#D32F2F" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
