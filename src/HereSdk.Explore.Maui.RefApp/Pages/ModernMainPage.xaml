<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Here.Explore.Maui.Controls;assembly=HereSdk.Explore.Maui"
             xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             xmlns:converters="clr-namespace:Here.Explore.Maui.RefApp.Converters"
             x:Class="Here.Explore.Maui.RefApp.Pages.ModernMainPage"
             x:DataType="viewmodels:ModernMainViewModel"
             Title="HERE SDK Explore"
             BackgroundColor="LightBlue">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBool" />
            <converters:NullOrEmptyToBoolConverter x:Key="NullOrEmptyToBool" />
            <converters:BoolToColorConverter x:Key="BoolToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Fullscreen map -->
        <controls:HereMapView
            x:Name="MapView"
            MapScheme="{Binding SelectedScheme}" />

        <!-- Dual search panel (top) -->
        <local:DualSearchPanel
            OriginQuery="{Binding OriginQuery, Mode=TwoWay}"
            DestinationQuery="{Binding DestinationQuery, Mode=TwoWay}"
            OriginSuggestions="{Binding OriginSuggestions}"
            DestinationSuggestions="{Binding DestinationSuggestions}"
            SearchOriginCommand="{Binding SearchOriginCommand}"
            SearchDestinationCommand="{Binding SearchDestinationCommand}"
            SelectOriginCommand="{Binding SelectOriginCommand}"
            SelectDestinationCommand="{Binding SelectDestinationCommand}"
            ClearOriginCommand="{Binding ClearOriginCommand}"
            ClearDestinationCommand="{Binding ClearDestinationCommand}"
            SwapLocationsCommand="{Binding SwapLocationsCommand}" />

        <!-- Right-side controls -->
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="End"
            Margin="0,0,16,0"
            Spacing="10">
            <!-- Zoom In -->
            <Button x:Name="ZoomInButton"
                    Text="+"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="White"
                    TextColor="#333333"
                    CornerRadius="22"
                    Command="{Binding ZoomInCommand}"
                    FontSize="24"
                    Padding="0"
                    Opacity="0.9">
                <Button.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="8" />
                </Button.Shadow>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <!-- Zoom Out -->
            <Button x:Name="ZoomOutButton"
                    Text="−"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="White"
                    TextColor="#333333"
                    CornerRadius="22"
                    Command="{Binding ZoomOutCommand}"
                    FontSize="24"
                    Padding="0"
                    Opacity="0.9">
                <Button.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="8" />
                </Button.Shadow>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <!-- Compass -->
            <Button x:Name="CompassButton"
                    Text="🧭"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="White"
                    CornerRadius="22"
                    Command="{Binding ResetMapOrientationCommand}"
                    FontSize="20"
                    Padding="0"
                    Opacity="0.9">
                <Button.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="8" />
                </Button.Shadow>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <!-- Location -->
            <Button x:Name="LocationButton"
                    Text="📍"
                    WidthRequest="52"
                    HeightRequest="52"
                    BackgroundColor="{Binding IsTrackingLocation, Converter={StaticResource BoolToColorConverter}, FallbackValue=White}"
                    CornerRadius="26"
                    Command="{Binding CenterOnLocationCommand}"
                    FontSize="22"
                    Padding="0"
                    Opacity="0.9">
                <Button.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="8" />
                </Button.Shadow>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <!-- Map Objects Toggle -->
            <Button x:Name="MapObjectsButton"
                    Text="🔶"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="White"
                    CornerRadius="24"
                    Command="{Binding ToggleMapObjectsPanelCommand}"
                    FontSize="20"
                    Padding="0"
                    Opacity="0.9">
                <Button.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="8" />
                </Button.Shadow>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <!-- Settings -->
            <Button x:Name="SettingsButton"
                    Text="⚙️"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="White"
                    CornerRadius="22"
                    Clicked="OnSettingsClicked"
                    FontSize="20"
                    Padding="0"
                    Opacity="0.9">
                <Button.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="8" />
                </Button.Shadow>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
        </VerticalStackLayout>

        <!-- Map style picker (bottom-right) -->
        <local:MapStylePicker
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="0,0,16,16"
            SelectedScheme="{Binding SelectedScheme}"
            ChangeMapSchemeCommand="{Binding ChangeMapSchemeCommand}" />

        <!-- Map objects panel -->
        <local:MapObjectsPanel
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="0,0,80,80"
            IsVisible="{Binding IsMapObjectsPanelVisible}"
            ToggleMarkersCommand="{Binding ToggleMarkersCommand}"
            ToggleCirclesCommand="{Binding ToggleCirclesCommand}"
            TogglePolylinesCommand="{Binding TogglePolylinesCommand}"
            TogglePolygonsCommand="{Binding TogglePolygonsCommand}"
            ClearAllCommand="{Binding ClearMapObjectsCommand}" />

        <!-- Calculate route button (prominent, below search panel) -->
        <Button Grid.Row="0"
                Text="Calculate Route"
                Command="{Binding CalculateRouteCommand}"
                BackgroundColor="#2196F3"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="24,12"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,180,0,0"
                IsVisible="{Binding CanCalculateRoute}">
            <Button.Shadow>
                <Shadow Brush="#602196F3" Offset="0,4" Radius="12" />
            </Button.Shadow>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.7" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>

        <!-- Route details panel (bottom, when route calculated) -->
        <local:RouteDetailsPanel
            VerticalOptions="End"
            DistanceText="{Binding DistanceText}"
            DurationText="{Binding DurationText}"
            Maneuvers="{Binding Maneuvers}"
            ClearRouteCommand="{Binding ClearRouteCommand}"
            HasRoute="{Binding HasRoute}" />

        <!-- Loading overlay -->
        <Grid IsVisible="{Binding IsLoading}"
              BackgroundColor="#80FFFFFF"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="#2196F3"
                                   Scale="1.5"
                                   WidthRequest="60"
                                   HeightRequest="60" />
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="#CCFFFFFF"
                        Padding="20,12"
                        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#40000000" Offset="0,4" Radius="12" />
                    </Border.Shadow>
                    <Label Text="Loading..."
                           FontSize="14"
                           TextColor="#333333"
                           HorizontalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
