<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             x:Class="Here.Explore.Maui.RefApp.MapItemsPage"
             x:DataType="viewmodels:MapItemsViewModel"
             Title="Map Items">

    <StackLayout Padding="10" Spacing="10">
        <Label Text="Map Items" FontSize="24" FontAttributes="Bold" />

        <Button Text="Add Polyline" Command="{Binding AddPolylineCommand}" />
        <Button Text="Add Polygon" Command="{Binding AddPolygonCommand}" />
        <Button Text="Add Arrow" Command="{Binding AddArrowCommand}" />
        <Button Text="Add Marker" Command="{Binding AddMarkerCommand}" />
        <Button Text="Clear All" Command="{Binding ClearAllCommand}" />

        <Label Text="{Binding StatusMessage}" FontSize="14" />
    </StackLayout>
</ContentPage>