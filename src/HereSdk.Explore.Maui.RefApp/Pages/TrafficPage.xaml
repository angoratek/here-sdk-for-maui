<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Here.Explore.Maui.Controls;assembly=HereSdk.Explore.Maui"
             xmlns:traffic="clr-namespace:Here.Explore.Maui.Models.Traffic;assembly=HereSdk.Explore.Maui"
             xmlns:local="clr-namespace:Here.Explore.Maui.RefApp.Controls"
             xmlns:viewmodels="clr-namespace:Here.Explore.Maui.RefApp.ViewModels"
             xmlns:converters="clr-namespace:Here.Explore.Maui.RefApp.Converters"
             x:Class="Here.Explore.Maui.RefApp.Pages.TrafficPage"
             x:DataType="viewmodels:TrafficViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:JamFactorToColorConverter x:Key="JamToColor" />
            <converters:TrafficIncidentTypeToIconConverter x:Key="IncidentTypeToIcon" />
            <converters:TrafficIncidentImpactToColorConverter x:Key="ImpactToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*">
        <!-- HERE SDK: HereMapView renders traffic flow polylines and incident markers.
             Toggle flow/incidents via ITrafficService.QueryFlowAsync() and QueryIncidentsAsync(). -->
        <controls:HereMapView x:Name="MapView" Grid.Row="0"
                               AutomationId="TrafficMapView"
                               SemanticProperties.Description="Map showing traffic flow and incidents" />

        <!-- Top controls -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="{StaticResource TopSafeMargin}"
                             VerticalOptions="Start">
        <local:ErrorBanner ErrorMessage="{Binding StatusMessage}"
                           RetryCommand="{Binding RefreshTrafficCommand}"
                           RetryText="Retry" />
        <Border Style="{StaticResource SearchPillBorder}"
                VerticalOptions="Start" Padding="10,8">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Flow" Style="{StaticResource ChipButton}"
                        FontFamily="InterSemiBold"
                        AutomationId="TrafficFlowButton"
                        Command="{Binding ToggleFlowCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsFlowVisible}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Incidents" Style="{StaticResource ChipButton}"
                        FontFamily="InterSemiBold"
                        AutomationId="TrafficIncidentsButton"
                        Command="{Binding ToggleIncidentsCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsIncidentsVisible}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button FontFamily="MaterialIcons" Text="&#xe5d5;" FontSize="16"
                        Style="{StaticResource MapFloatingButton}"
                        AutomationId="TrafficRefreshButton"
                        WidthRequest="36" HeightRequest="36" CornerRadius="18"
                        Command="{Binding RefreshTrafficCommand}" />
            </HorizontalStackLayout>
        </Border>
        </VerticalStackLayout>

        <!-- HERE SDK: Traffic flow legend — colors map to JamFactor values returned by ITrafficService.
             Free (green), Moderate (yellow), Heavy (red) as rendered by JamFactorToColorConverter. -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10"
                VerticalOptions="End" HorizontalOptions="Start"
                Margin="12,0,0,12"
                IsVisible="{Binding IsFlowVisible}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Traffic Flow" FontSize="11" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <HorizontalStackLayout Spacing="6">
                    <BoxView WidthRequest="30" HeightRequest="6" Color="{StaticResource TrafficFreeFlow}" CornerRadius="3" />
                    <Label Text="Free" FontSize="10" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <BoxView WidthRequest="30" HeightRequest="6" Color="{StaticResource TrafficModerate}" CornerRadius="3" />
                    <Label Text="Moderate" FontSize="10" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <BoxView WidthRequest="30" HeightRequest="6" Color="{StaticResource TrafficHeavy}" CornerRadius="3" />
                    <Label Text="Heavy" FontSize="10" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Status message -->
        <Label Grid.Row="0" Text="{Binding StatusMessage}" FontSize="12"
               VerticalOptions="End" HorizontalOptions="Center"
               Margin="0,0,0,200"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

        <!-- HERE SDK: Incident list populated from ITrafficService.QueryIncidentsAsync().
             Each TrafficIncident has Type, Impact, Description — rendered as cards with tap-to-select. -->
        <local:BottomSheet x:Name="IncidentSheet" Grid.Row="0"
                           CollapsedHeight="80"
                           HalfExpandedHeight="420"
                           IsVisible="{Binding IsIncidentsVisible}">
            <local:BottomSheet.HeaderContent>
                <Label Text="{Binding StatusMessage}" FontSize="14" Margin="16,4" />
            </local:BottomSheet.HeaderContent>
            <local:BottomSheet.SheetContent>
                <CollectionView ItemsSource="{Binding Incidents}" Margin="16,4">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="traffic:TrafficIncident">
                            <Border Style="{StaticResource CompactCardBorder}" Margin="0,4" Padding="12">
                                <Grid ColumnDefinitions="Auto,3,*,Auto" ColumnSpacing="12">
                                    <!-- Severity rail: impact color strip on the card's left edge -->
                                    <BoxView Grid.Column="1" WidthRequest="3" CornerRadius="1.5"
                                             Color="{Binding Impact, Converter={StaticResource ImpactToColor}}"
                                             VerticalOptions="Fill" />
                                    <!-- Type icon disc -->
                                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                            StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary10}, Dark={StaticResource Primary30}}"
                                            VerticalOptions="Center">
                                        <Label FontFamily="MaterialIcons"
                                               Text="{Binding Type, Converter={StaticResource IncidentTypeToIcon}}"
                                               FontSize="19"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <!-- Description -->
                                        <Label Text="{Binding Description}" FontFamily="InterSemiBold" FontSize="13.5"
                                               LineBreakMode="TailTruncation" MaxLines="2"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <!-- Type + Impact -->
                                        <Label FontFamily="InterRegular" FontSize="11.5"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="Type" />
                                                    <Binding Path="Impact" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TrafficViewModel}}, Path=SelectIncidentCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </local:BottomSheet.SheetContent>
        </local:BottomSheet>

        <!-- Empty state -->
        <local:EmptyStateView Grid.Row="0"
                               Icon="🚦"
                               Title="{Binding EmptyStateTitle}"
                               Subtitle="{Binding EmptyStateSubtitle}" />

        <!-- Loading indicator: centered pill, map stays interactive -->
        <Grid Grid.Row="0" InputTransparent="True" IsVisible="{Binding IsLoading}">
            <Border HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="18,12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceSecondaryDark}}">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowColor}, Dark={StaticResource ShadowColorDark}}"
                            Offset="0,4" Radius="16" />
                </Border.Shadow>
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="True"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="Loading traffic…" FontSize="15" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
