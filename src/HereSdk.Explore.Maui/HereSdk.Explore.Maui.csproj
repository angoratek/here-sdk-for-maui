<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <PackageId>HereSdk.Explore.Maui</PackageId>
    <Description>HERE SDK Explore Edition for .NET MAUI — cross-platform maps, routing, search, traffic, and location</Description>
    <PackageTags>here;sdk;maui;maps;routing;search;traffic;navigation;location</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>HERE SDK for MAUI Contributors</Authors>
    <Copyright>Copyright (c) 2026</Copyright>
    <PackageProjectUrl>https://github.com/angoratek/here-sdk-for-maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/angoratek/here-sdk-for-maui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/angoratek/here-sdk-for-maui/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Version>$(PackageVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HereSdk.Explore.Maui.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <ProjectReference Include="..\HereSdk.Explore.Android.Binding\HereSdk.Explore.Android.Binding.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('ios'))">
    <ProjectReference Include="..\HereSdk.Explore.iOS.Binding\HereSdk.Explore.iOS.Binding.csproj" />
  </ItemGroup>
</Project>